{
  "manifest_version": 3,
  "name": "ZenTab Dashboard",
  "short_name": "ZenTab",
  "version": "1.7",
  "description": "A premium dashboard for your pinned links and sections.",
  "author": "Saurav Sarma",
  "offline_enabled": true,
  "permissions": [
    "storage",
    "tabs",
    "favicon"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "./logos/logo16.png",
    "32": "./logos/logo32.png",
    "64": "./logos/logo64.png",
    "48": "./logos/logo48.png",
    "128": "./logos/logo128.png"
  }
}