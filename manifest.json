{
  "manifest_version": 3,
  "name": "ZenTab Dashboard",
  "short_name": "ZenTab",
  "version": "1.2",
  "description": "A premium dashboard for your pinned links and sections.",
  "author": "Saurav Sarma",
  "offline_enabled": true,
  "permissions": [
    "storage"
  ],
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icon64.png",
    "32": "icon64.png",
    "48": "icon64.png",
    "128": "icon128.png"
  }
}